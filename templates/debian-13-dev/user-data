#cloud-config
# JuanitOS template "debian-13-dev": Debian 13 (trixie) for development,
# with Docker Engine, Compose and Buildx from Debian's own (signed)
# archive.
#
# `jos template install debian-13-dev` writes Debian's official `generic`
# image (the full kernel: the `genericcloud` one lacks 9p, which the dom0
# share needs) to the template's zvol and boots it once with this file on a
# NoCloud seed disk ("cidata"); cloud-init provisions the system and powers
# it off, then jos snapshots the template as @base. App qubes are ZFS
# clones of that snapshot.

hostname: debian-13-dev
# 127.0.1.1 for the name: sudo resolves the hostname, and a lookup that
# has to go out to the network stalls every `sudo` on a qube that is
# still getting its lease.
manage_etc_hosts: localhost

users:
  - default
  # QubesOS convention: one unprivileged "user" with passwordless sudo. The
  # only way in is the serial console, reachable from dom0 alone.
  - name: user
    gecos: JuanitOS user
    shell: /bin/bash
    groups: [sudo]
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    lock_passwd: true

package_update: true
package_upgrade: true
packages:
  # containers
  - docker.io
  - docker-compose
  - docker-buildx
  - containerd
  # everyday development
  - build-essential
  - pkg-config
  - git
  - curl
  - ca-certificates
  - jq
  - tmux
  - vim
  - htop
  - unzip
  - openssh-client
  - python3
  - python3-venv

write_files:
  # Networking for every clone: cloud-init's own netplan pins the NIC by
  # the MAC address of the template's provisioning boot, and each qube
  # gets its own MAC (runcmd removes that file). DHCP over the first
  # virtio NIC, from sys-firewall; IPv4 only, as the firewall is.
  - path: /etc/netplan/10-jos.yaml
    permissions: "0600"
    content: |
      network:
        version: 2
        ethernets:
          uplink:
            match:
              name: "en*"
            dhcp4: true
            dhcp6: false
  # `jos console <qube>` lands in a shell: autologin on the serial console.
  - path: /etc/systemd/system/serial-getty@ttyS0.service.d/autologin.conf
    permissions: "0644"
    content: |
      [Service]
      ExecStart=
      ExecStart=-/sbin/agetty --autologin user --keep-baud 115200,57600,38400,9600 - $TERM
  # Docker's data on the qube's own disk, logs bounded.
  - path: /etc/docker/daemon.json
    permissions: "0644"
    content: |
      {
        "log-driver": "local",
        "log-opts": { "max-size": "10m" }
      }
  # The events port (/dev/virtio-ports/events, the agent channel's second
  # port): writable by the qube's users, so jos-copy can wake dom0's broker.
  - path: /etc/udev/rules.d/90-jos.rules
    permissions: "0644"
    content: |
      SUBSYSTEM=="virtio-ports", ATTR{name}=="events", MODE="0622"
  # The guest agent: mounts the dom0 share and sets the hostname (see
  # templates/agent/jos-agent, docs/inter-qube.md).
  - path: /usr/local/sbin/jos-agent
    permissions: "0755"
    content: |
      #!/bin/sh
      # JuanitOS guest agent for Linux qubes: mount the dom0 share (virtio-9p,
      # tag "jos") on /mnt/jos and take the qube's name from it as the hostname,
      # so every clone of a template boots under its own name. Without a share
      # (the template booted elsewhere) nothing happens.
      modprobe 9pnet_virtio 2>/dev/null
      mkdir -p /mnt/jos
      if ! mount -t 9p -o trans=virtio,version=9p2000.L jos /mnt/jos 2>/dev/null; then
          echo "jos-agent: no dom0 share"
          exit 0
      fi
      qube=$(head -n 1 /mnt/jos/name 2>/dev/null)
      [ -n "$qube" ] || exit 0
      hostname "$qube"
      if [ "$(cat /etc/hostname 2>/dev/null)" != "$qube" ]; then
          echo "$qube" > /etc/hostname
          if grep -q '^127\.0\.1\.1' /etc/hosts; then
              sed -i "s/^127\.0\.1\.1.*/127.0.1.1 $qube/" /etc/hosts
          else
              echo "127.0.1.1 $qube" >> /etc/hosts
          fi
      fi
      echo "jos-agent: this is qube $qube"
  - path: /etc/systemd/system/jos-agent.service
    permissions: "0644"
    content: |
      [Unit]
      Description=JuanitOS guest agent (dom0 share and hostname)
      DefaultDependencies=no
      After=local-fs.target systemd-modules-load.service
      Before=network-pre.target sysinit.target

      [Service]
      Type=oneshot
      RemainAfterExit=yes
      ExecStart=/usr/local/sbin/jos-agent

      [Install]
      WantedBy=sysinit.target

  # jos-copy PATH QUBE: ask dom0 to copy a file to another qube (see
  # templates/agent/jos-copy, docs/inter-qube.md).
  - path: /usr/local/bin/jos-copy
    permissions: "0755"
    content: |
      #!/bin/sh
      # jos-copy PATH QUBE: ask dom0 to copy PATH from this qube into QUBE's
      # inbox (/mnt/jos/in/<this qube>/ there). The file goes to the outbox of
      # the dom0 share, a request goes to /mnt/jos/req/, and dom0 (`jos serve`)
      # answers according to its policy: delivered, denied, or held for the
      # operator (`jos requests`). See docs/inter-qube.md.
      set -u
      usage() { echo "usage: jos-copy PATH QUBE" >&2; exit 64; }
      [ $# -eq 2 ] || usage
      path=$1
      dst=$2
      share=/mnt/jos
      timeout=${JOS_COPY_TIMEOUT:-600}
      [ -d "$share/req" ] || { echo "jos-copy: dom0 share not mounted at $share" >&2; exit 2; }
      [ -e "$path" ] || { echo "jos-copy: $path: no such file or directory" >&2; exit 1; }
      base=$(basename "$path")
      case $base in ''|.|..|*/*) echo "jos-copy: $path: cannot copy that" >&2; exit 1;; esac
      # A previous export of the same name still in the outbox is one dom0 has
      # not consumed yet: a guest user cannot remove it (dom0 does, once it has
      # answered), so wait for that rather than copy into it.
      if [ -e "$share/out/$base" ]; then
          echo "jos-copy: $base is still being handled by dom0; try again shortly" >&2
          exit 75
      fi
      # Follow symbolic links: the share cannot hold them.
      cp -RL "$path" "$share/out/$base" || exit 1
      id="$(date +%s)-$$"
      req="$share/req/$id"
      # The request appears atomically, complete.
      printf 'copy %s %s\n' "$base" "$dst" > "$req.tmp" && mv "$req.tmp" "$req" || exit 1
      # Ring dom0's doorbell: one line on the qube's events port (the second
      # virtio-console port, made writable by the template) wakes `jos serve`
      # before its next poll. Best effort: without it the poll finds the request.
      for bell in /dev/vtcon/events /dev/virtio-ports/events; do
          if [ -w "$bell" ]; then
              printf 'REQUEST %s\n' "$id" > "$bell" 2>/dev/null && break
          fi
      done
      echo "jos-copy: asked dom0 to copy $base to $dst (request $id)"
      # dom0 answers within milliseconds when the doorbell works: look often
      # (quarter seconds; FreeBSD's and GNU sleep take fractions).
      waited=0
      while [ ! -e "$req.reply" ]; do
          if [ "$waited" -ge "$((timeout * 4))" ]; then
              echo "jos-copy: no answer from dom0 after ${timeout}s; still pending as $id" >&2
              exit 75
          fi
          sleep 0.25
          waited=$((waited + 1))
      done
      reply=$(cat "$req.reply")
      # dom0 sweeps replies a minute later (a guest user cannot unlink them).
      echo "jos-copy: $reply"
      case $reply in
          ok\ *) exit 0;;
          denied*) exit 77;;
          *) exit 1;;
      esac

  # jos-agentd: runs what `jos run` sends over the agent channel, a
  # virtio-console port (see templates/agent/jos-agentd, docs/inter-qube.md).
  - path: /usr/local/sbin/jos-agentd
    permissions: "0755"
    content: |
      #!/bin/sh
      # JuanitOS guest agent daemon: runs the commands dom0 sends over the
      # qube's agent channel, a bhyve virtio-console port named "jos"
      # (FreeBSD: /dev/ttyV0.0, Linux: /dev/virtio-ports/jos). Replaces typing
      # into the serial console for `jos run`; see docs/inter-qube.md.
      #
      # Protocol, one request at a time, lines of text:
      #   dom0  -> guest   PING <id>
      #   guest -> dom0    PONG <id>
      #   dom0  -> guest   RUN <id> <user> <command...>
      #   guest -> dom0    the command's stdout and stderr, then
      #                    END <id> <exit status>
      # The id is dom0's (unique per request) so its reply cannot be confused
      # with the command's output. Commands run as <user> (root included) with
      # stdin from /dev/null. Nothing is accepted from anyone but dom0: the
      # channel only exists on this VM's host side.
      dev=""
      tty=""
      if [ -e /dev/ttyV0.0 ]; then
          dev=/dev/ttyV0.0
          tty=yes
      elif [ -e /dev/virtio-ports/jos ]; then
          dev=/dev/virtio-ports/jos
      else
          # No udev symlink: find the port by name in sysfs (vportNpM).
          for n in /sys/class/virtio-ports/*/name; do
              if [ -r "$n" ] && [ "$(cat "$n")" = jos ]; then
                  p=${n%/name}
                  dev=/dev/${p##*/}
                  break
              fi
          done
      fi
      if [ -z "$dev" ]; then
          echo "jos-agentd: no agent channel (not under JuanitOS?)"
          exit 0
      fi
      echo "jos-agentd: serving $dev"

      # The PATH commands get (rc and systemd start this daemon with a short
      # one; Linux's su resets it from login.defs anyway).
      export PATH=/sbin:/bin:/usr/sbin:/usr/bin:/usr/local/sbin:/usr/local/bin

      run_as() {
          # $1 user, $2 command. su (root included) sets HOME/USER/SHELL for the
          # target user and runs its shell (a POSIX sh in the templates); the
          # command starts in the home directory, as after a login. Not `su -l`:
          # the login profile would print its fortune into the output.
          su "$1" -c "cd; $2"
      }

      # One descriptor for both directions, held open for good: Linux allows a
      # single open of a virtio port and throws away what arrives while the
      # port is closed, so closing between requests would lose dom0's lines.
      exec 3<>"$dev" || exit 1
      # Raw tty: no echo of dom0's lines, no CR/LF translation. Set while the
      # descriptor is open: FreeBSD resets a tty's modes on its last close.
      [ -n "$tty" ] && stty raw -echo <&3
      while :; do
          # Linux reads EOF until dom0 has connected once (FreeBSD's block);
          # what dom0 sends meanwhile is queued, so just try again.
          if ! IFS= read -r line <&3; then
              sleep 1
              continue
          fi
          case $line in
          "PING "*)
              printf 'PONG %s\n' "${line#PING }" >&3
              ;;
          "RUN "*)
              rest=${line#RUN }
              id=${rest%% *}
              rest=${rest#* }
              user=${rest%% *}
              cmd=${rest#* }
              run_as "$user" "$cmd" </dev/null >&3 2>&1
              printf '\nEND %s %s\n' "$id" "$?" >&3
              ;;
          esac
      done
  - path: /etc/systemd/system/jos-agentd.service
    content: |
      [Unit]
      Description=JuanitOS guest agent daemon (jos run)
      DefaultDependencies=no
      After=jos-agent.service
      Before=sysinit.target
      StartLimitIntervalSec=0

      [Service]
      ExecStart=/usr/local/sbin/jos-agentd
      Restart=always
      RestartSec=5

      [Install]
      WantedBy=sysinit.target

runcmd:
  - [usermod, -aG, docker, user]
  - [systemctl, enable, containerd.service, docker.service, jos-agent.service, jos-agentd.service]
  - [systemctl, daemon-reload]
  - [apt-get, clean]
  # App qubes are clones of this template: cloud-init must not run again
  # in them (no seed disk there; jos-agent gives each clone its name).
  - [touch, /etc/cloud/cloud-init.disabled]
  - [rm, -f, /etc/netplan/50-cloud-init.yaml]

power_state:
  mode: poweroff
  message: JuanitOS template debian-13-dev provisioned
  timeout: 60
  condition: true

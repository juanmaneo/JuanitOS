#!/bin/sh
# JuanitOS guest agent daemon: runs the commands dom0 sends over the
# qube's agent channel, a bhyve virtio-console port named "jos"
# (FreeBSD: /dev/ttyV0.0, Linux: /dev/virtio-ports/jos). Replaces typing
# into the serial console for `jos run`; see docs/inter-qube.md.
#
# Protocol, one request at a time, lines of text:
#   dom0  -> guest   PING <id>
#   guest -> dom0    PONG <id>
#   dom0  -> guest   RUN <id> <user> <command...>
#   guest -> dom0    the command's stdout and stderr, then
#                    END <id> <exit status>
# The id is dom0's (unique per request) so its reply cannot be confused
# with the command's output. Commands run as <user> (root included) with
# stdin from /dev/null. Nothing is accepted from anyone but dom0: the
# channel only exists on this VM's host side.
dev=""
tty=""
if [ -e /dev/ttyV0.0 ]; then
    dev=/dev/ttyV0.0
    tty=yes
elif [ -e /dev/virtio-ports/jos ]; then
    dev=/dev/virtio-ports/jos
else
    # No udev symlink: find the port by name in sysfs (vportNpM).
    for n in /sys/class/virtio-ports/*/name; do
        if [ -r "$n" ] && [ "$(cat "$n")" = jos ]; then
            p=${n%/name}
            dev=/dev/${p##*/}
            break
        fi
    done
fi
if [ -z "$dev" ]; then
    echo "jos-agentd: no agent channel (not under JuanitOS?)"
    exit 0
fi
echo "jos-agentd: serving $dev"

# The PATH commands get (rc and systemd start this daemon with a short
# one; Linux's su resets it from login.defs anyway).
export PATH=/sbin:/bin:/usr/sbin:/usr/bin:/usr/local/sbin:/usr/local/bin

run_as() {
    # $1 user, $2 command. su (root included) sets HOME/USER/SHELL for the
    # target user and runs its shell (a POSIX sh in the templates); the
    # command starts in the home directory, as after a login. Not `su -l`:
    # the login profile would print its fortune into the output.
    su "$1" -c "cd; $2"
}

# One descriptor for both directions, held open for good: Linux allows a
# single open of a virtio port and throws away what arrives while the
# port is closed, so closing between requests would lose dom0's lines.
exec 3<>"$dev" || exit 1
# Raw tty: no echo of dom0's lines, no CR/LF translation. Set while the
# descriptor is open: FreeBSD resets a tty's modes on its last close.
[ -n "$tty" ] && stty raw -echo <&3
while :; do
    # Linux reads EOF until dom0 has connected once (FreeBSD's block);
    # what dom0 sends meanwhile is queued, so just try again.
    if ! IFS= read -r line <&3; then
        sleep 1
        continue
    fi
    case $line in
    "PING "*)
        printf 'PONG %s\n' "${line#PING }" >&3
        ;;
    "RUN "*)
        rest=${line#RUN }
        id=${rest%% *}
        rest=${rest#* }
        user=${rest%% *}
        cmd=${rest#* }
        run_as "$user" "$cmd" </dev/null >&3 2>&1
        printf '\nEND %s %s\n' "$id" "$?" >&3
        ;;
    esac
done

#cloud-config
# JuanitOS template "fbsd15-dev": FreeBSD 15.1 for development, with
# Podman (OCI containers on FreeBSD jails, `podman-suite`).
#
# `jos template install fbsd15-dev` writes FreeBSD's official
# BASIC-CLOUDINIT ZFS image to the template's zvol and boots it once with
# this file on a NoCloud seed disk ("cidata"). FreeBSD's nuageinit(7)
# applies it on that first boot only (`firstboot`), so app qubes cloned
# from the template never re-run it. The last command powers the template
# off; jos then snapshots it as @base.
#
# Everything is done in `runcmd`, in order: nuageinit's other keys run in
# an order of its own, and Podman's setup depends on its packages.
#
# Two things learnt booting this on FreeBSD 15.1:
# - the image uses pkgbase, so `pkg upgrade` may install a newer kernel:
#   do not load kernel modules in this boot (fdescfs and pf come up from
#   fstab/rc.conf on the next one, i.e. in every app qube);
# - nuageinit's scripts run while /firstboot exists, and /etc/rc only
#   removes it at the very end of the boot. Remove it here before powering
#   off, or a slow boot gets cut short and everything runs again.

hostname: fbsd15-dev

write_files:
  # The guest agent: mounts the dom0 share and sets the hostname (see
  # templates/agent/jos_agent, docs/inter-qube.md).
  - path: /usr/local/etc/rc.d/jos_agent
    permissions: "0755"
    content: |
      #!/bin/sh
      # PROVIDE: jos_agent
      # REQUIRE: FILESYSTEMS hostname
      # BEFORE: netif
      #
      # JuanitOS guest agent for FreeBSD qubes: mount the dom0 share (virtio-9p,
      # tag "jos") on /mnt/jos and take the qube's name from it as the hostname,
      # so every clone of a template boots under its own name instead of the
      # template's from rc.conf (which /etc/rc.d/hostname has just applied).
      # Without a share (the template booted elsewhere) nothing happens.
      . /etc/rc.subr
      name=jos_agent
      rcvar=jos_agent_enable
      start_cmd=jos_agent_start
      stop_cmd=:
      jos_agent_start() {
          kldload -n virtio_p9fs || return 0
          mkdir -p /mnt/jos
          if ! mount -t p9fs jos /mnt/jos 2>/dev/null; then
              echo "jos_agent: no dom0 share"
              return 0
          fi
          qube=$(head -n 1 /mnt/jos/name 2>/dev/null)
          if [ -n "$qube" ]; then
              hostname "$qube"
              echo "jos_agent: this is qube $qube"
          fi
      }
      load_rc_config $name
      run_rc_command "$1"

  # jos-copy PATH QUBE: ask dom0 to copy a file to another qube (see
  # templates/agent/jos-copy, docs/inter-qube.md).
  - path: /usr/local/bin/jos-copy
    permissions: "0755"
    content: |
      #!/bin/sh
      # jos-copy PATH QUBE: ask dom0 to copy PATH from this qube into QUBE's
      # inbox (/mnt/jos/in/<this qube>/ there). The file goes to the outbox of
      # the dom0 share, a request goes to /mnt/jos/req/, and dom0 (`jos serve`)
      # answers according to its policy: delivered, denied, or held for the
      # operator (`jos requests`). See docs/inter-qube.md.
      set -u
      usage() { echo "usage: jos-copy PATH QUBE" >&2; exit 64; }
      [ $# -eq 2 ] || usage
      path=$1
      dst=$2
      share=/mnt/jos
      timeout=${JOS_COPY_TIMEOUT:-600}
      [ -d "$share/req" ] || { echo "jos-copy: dom0 share not mounted at $share" >&2; exit 2; }
      [ -e "$path" ] || { echo "jos-copy: $path: no such file or directory" >&2; exit 1; }
      base=$(basename "$path")
      case $base in ''|.|..|*/*) echo "jos-copy: $path: cannot copy that" >&2; exit 1;; esac
      # A previous export of the same name still in the outbox is one dom0 has
      # not consumed yet: a guest user cannot remove it (dom0 does, once it has
      # answered), so wait for that rather than copy into it.
      if [ -e "$share/out/$base" ]; then
          echo "jos-copy: $base is still being handled by dom0; try again shortly" >&2
          exit 75
      fi
      # Follow symbolic links: the share cannot hold them.
      cp -RL "$path" "$share/out/$base" || exit 1
      id="$(date +%s)-$$"
      req="$share/req/$id"
      # The request appears atomically, complete.
      printf 'copy %s %s\n' "$base" "$dst" > "$req.tmp" && mv "$req.tmp" "$req" || exit 1
      # Ring dom0's doorbell: one line on the qube's events port (the second
      # virtio-console port, made writable by the template) wakes `jos serve`
      # before its next poll. Best effort: without it the poll finds the request.
      for bell in /dev/vtcon/events /dev/virtio-ports/events; do
          if [ -w "$bell" ]; then
              printf 'REQUEST %s\n' "$id" > "$bell" 2>/dev/null && break
          fi
      done
      echo "jos-copy: asked dom0 to copy $base to $dst (request $id)"
      # dom0 answers within milliseconds when the doorbell works: look often
      # (quarter seconds; FreeBSD's and GNU sleep take fractions).
      waited=0
      while [ ! -e "$req.reply" ]; do
          if [ "$waited" -ge "$((timeout * 4))" ]; then
              echo "jos-copy: no answer from dom0 after ${timeout}s; still pending as $id" >&2
              exit 75
          fi
          sleep 0.25
          waited=$((waited + 1))
      done
      reply=$(cat "$req.reply")
      # dom0 sweeps replies a minute later (a guest user cannot unlink them).
      echo "jos-copy: $reply"
      case $reply in
          ok\ *) exit 0;;
          denied*) exit 77;;
          *) exit 1;;
      esac

  # jos-agentd: runs what `jos run` sends over the agent channel, a
  # virtio-console port (see templates/agent/jos-agentd, docs/inter-qube.md).
  - path: /usr/local/sbin/jos-agentd
    permissions: "0755"
    content: |
      #!/bin/sh
      # JuanitOS guest agent daemon: runs the commands dom0 sends over the
      # qube's agent channel, a bhyve virtio-console port named "jos"
      # (FreeBSD: /dev/ttyV0.0, Linux: /dev/virtio-ports/jos). Replaces typing
      # into the serial console for `jos run`; see docs/inter-qube.md.
      #
      # Protocol, one request at a time, lines of text:
      #   dom0  -> guest   PING <id>
      #   guest -> dom0    PONG <id>
      #   dom0  -> guest   RUN <id> <user> <command...>
      #   guest -> dom0    the command's stdout and stderr, then
      #                    END <id> <exit status>
      # The id is dom0's (unique per request) so its reply cannot be confused
      # with the command's output. Commands run as <user> (root included) with
      # stdin from /dev/null. Nothing is accepted from anyone but dom0: the
      # channel only exists on this VM's host side.
      dev=""
      tty=""
      if [ -e /dev/ttyV0.0 ]; then
          dev=/dev/ttyV0.0
          tty=yes
      elif [ -e /dev/virtio-ports/jos ]; then
          dev=/dev/virtio-ports/jos
      else
          # No udev symlink: find the port by name in sysfs (vportNpM).
          for n in /sys/class/virtio-ports/*/name; do
              if [ -r "$n" ] && [ "$(cat "$n")" = jos ]; then
                  p=${n%/name}
                  dev=/dev/${p##*/}
                  break
              fi
          done
      fi
      if [ -z "$dev" ]; then
          echo "jos-agentd: no agent channel (not under JuanitOS?)"
          exit 0
      fi
      echo "jos-agentd: serving $dev"

      # The PATH commands get (rc and systemd start this daemon with a short
      # one; Linux's su resets it from login.defs anyway).
      export PATH=/sbin:/bin:/usr/sbin:/usr/bin:/usr/local/sbin:/usr/local/bin

      run_as() {
          # $1 user, $2 command. su (root included) sets HOME/USER/SHELL for the
          # target user and runs its shell (a POSIX sh in the templates); the
          # command starts in the home directory, as after a login. Not `su -l`:
          # the login profile would print its fortune into the output.
          su "$1" -c "cd; $2"
      }

      # One descriptor for both directions, held open for good: Linux allows a
      # single open of a virtio port and throws away what arrives while the
      # port is closed, so closing between requests would lose dom0's lines.
      exec 3<>"$dev" || exit 1
      # Raw tty: no echo of dom0's lines, no CR/LF translation. Set while the
      # descriptor is open: FreeBSD resets a tty's modes on its last close.
      [ -n "$tty" ] && stty raw -echo <&3
      while :; do
          # Linux reads EOF until dom0 has connected once (FreeBSD's block);
          # what dom0 sends meanwhile is queued, so just try again.
          if ! IFS= read -r line <&3; then
              sleep 1
              continue
          fi
          case $line in
          "PING "*)
              printf 'PONG %s\n' "${line#PING }" >&3
              ;;
          "RUN "*)
              rest=${line#RUN }
              id=${rest%% *}
              rest=${rest#* }
              user=${rest%% *}
              cmd=${rest#* }
              run_as "$user" "$cmd" </dev/null >&3 2>&1
              printf '\nEND %s %s\n' "$id" "$?" >&3
              ;;
          esac
      done
  - path: /usr/local/etc/rc.d/jos_agentd
    permissions: "0755"
    content: |
      #!/bin/sh
      # PROVIDE: jos_agentd
      # REQUIRE: jos_agent
      #
      # JuanitOS guest agent daemon for FreeBSD qubes (templates/agent/jos-agentd):
      # answers `jos run` over the virtio-console channel. Started early, before
      # the network, so dom0 can drive a qube that has none.
      . /etc/rc.subr
      name=jos_agentd
      rcvar=jos_agentd_enable
      pidfile=/var/run/jos-agentd.pid
      command=/usr/sbin/daemon
      command_args="-f -r -R 5 -P $pidfile /usr/local/sbin/jos-agentd"
      load_rc_config $name
      run_rc_command "$1"

runcmd:
  # Packages: Podman with the ocijail runtime and buildah, plus tools.
  - env ASSUME_ALWAYS_YES=yes pkg bootstrap -f
  - env ASSUME_ALWAYS_YES=yes pkg update
  - env ASSUME_ALWAYS_YES=yes pkg upgrade
  - env ASSUME_ALWAYS_YES=yes pkg install podman-suite git curl jq tmux vim htop doas rust python3
  # QubesOS convention: one unprivileged "user", root via doas without a
  # password. The only way in is the serial console, reachable from dom0.
  - pw useradd user -m -c "JuanitOS user" -G wheel -s /bin/sh
  - echo 'permit nopass :wheel' > /usr/local/etc/doas.conf
  # Podman needs fdescfs and pf (NAT for container networks), both from the
  # next boot on.
  - echo 'fdesc /dev/fd fdescfs rw 0 0' >> /etc/fstab
  - sed -e 's/^v4egress_if = .*/v4egress_if = "vtnet0"/' -e 's/^v6egress_if = .*/v6egress_if = "vtnet0"/' /usr/local/etc/containers/pf.conf.sample > /etc/pf.conf
  # linux_enable: Linux images run too (`podman run --os=linux ...`).
  - sysrc pf_enable=YES podman_enable=YES linux_enable=YES jos_agent_enable=YES jos_agentd_enable=YES
  # The events port (/dev/vtcon/events, the agent channel's second port):
  # writable by the qube's users, so jos-copy can wake dom0's broker.
  - echo 'perm vtcon/events 0622' >> /etc/devfs.conf
  - echo 'net.pf.filter_local=1' >> /etc/sysctl.conf
  # Container storage on its own dataset (the zfs storage driver).
  - zfs create -o mountpoint=/var/db/containers zroot/containers
  # `jos console <qube>` lands in a shell: autologin on the serial console.
  - printf 'jos.autologin:\\\n\t:al=user:tc=3wire:\n' >> /etc/gettytab
  - sed -i '' -e 's|^ttyu0.*|ttyu0 "/usr/libexec/getty jos.autologin" vt100 onifconsole secure|' /etc/ttys
  - pkg clean -ay
  - rm -f /firstboot /var/cache/nuageinit/runcmds
  - shutdown -p now

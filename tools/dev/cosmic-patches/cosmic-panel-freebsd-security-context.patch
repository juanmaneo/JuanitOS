         let s: String = Alphanumeric.sample_string(&mut rand::rng(), 50);
+        #[cfg(target_os = "linux")]
         let addr = SocketAddr::from_abstract_name(s)?;
+        #[cfg(not(target_os = "linux"))]
+        let addr = {
+            let dir = std::env::var_os("XDG_RUNTIME_DIR")

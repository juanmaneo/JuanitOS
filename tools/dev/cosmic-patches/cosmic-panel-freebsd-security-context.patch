Abstract unix socket names (std::os::linux::net::SocketAddrExt) are Linux
only. Elsewhere the security-context listener gets a socket file under
XDG_RUNTIME_DIR, removed when the context is dropped. Applied to
cosmic-panel by tools/dev/cosmic-build.sh patch.
--- a/cosmic-panel-bin/src/xdg_shell_wrapper/client/handlers/wp_security_context.rs
+++ b/cosmic-panel-bin/src/xdg_shell_wrapper/client/handlers/wp_security_context.rs
@@ -1,3 +1,4 @@
+#[cfg(target_os = "linux")]
 use std::os::linux::net::SocketAddrExt;
 use std::os::unix::io::AsFd;
 use std::os::unix::net::{SocketAddr, UnixListener, UnixStream};
@@ -28,8 +29,13 @@
 impl Drop for SecurityContext {
     fn drop(&mut self) {
         let mut guard = self.conn.lock().unwrap();
-        if let Some((stream, _)) = guard.take() {
+        if let Some((stream, listener)) = guard.take() {
             let _ = stream.shutdown(std::net::Shutdown::Both);
+            if let Some(path) =
+                listener.local_addr().ok().and_then(|a| a.as_pathname().map(|p| p.to_path_buf()))
+            {
+                let _ = std::fs::remove_file(path);
+            }
         }
     }
 }

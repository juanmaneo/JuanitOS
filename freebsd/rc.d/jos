#!/bin/sh
#
# PROVIDE: jos
# REQUIRE: LOGIN zfs netif
# KEYWORD: shutdown
#
# Add the following to /etc/rc.conf to enable JuanitOS qube autostart:
#
# jos_enable="YES"
# jos_config="/usr/local/etc/juanitos/jos.toml"   (optional)
# jos_serve_enable="YES"   answer qube requests (`jos serve`) per the policy
# jos_stop_timeout="20"    seconds each tier of qubes gets to power off at
#                          shutdown (three tiers; rcshutdown_timeout is 90)

. /etc/rc.subr

name="jos"
rcvar="jos_enable"

load_rc_config $name

: ${jos_enable:="NO"}
: ${jos_config:="/usr/local/etc/juanitos/jos.toml"}
: ${jos_bin:="/usr/local/bin/jos"}
: ${jos_serve_enable:="YES"}
: ${jos_stop_timeout:="20"}

start_cmd="jos_start"
stop_cmd="jos_stop"
status_cmd="jos_status"

: ${jos_splash_bin:="/usr/local/bin/jos-splash"}
serve_pidfile="/var/run/juanitos/serve.pid"

jos_start()
{
	echo "Starting JuanitOS qubes."
	if [ -x "${jos_splash_bin}" ]; then
		"${jos_splash_bin}" status "Starting qubes"
	fi
	# The request broker (jos-copy in the qubes, docs/inter-qube.md).
	if checkyesno jos_serve_enable; then
		mkdir -p /var/run/juanitos
		/usr/sbin/daemon -f -p "${serve_pidfile}" -o /var/run/juanitos/serve.log \
			"${jos_bin}" --config "${jos_config}" serve
	fi
	# Each qube gets its own detached `jos supervise` process, logging to
	# /var/run/juanitos/<name>.log.
	"${jos_bin}" --config "${jos_config}" autostart
	if [ -x "${jos_splash_bin}" ]; then
		"${jos_splash_bin}" stage qubes
		"${jos_splash_bin}" status
	fi
}

jos_stop()
{
	echo "Stopping JuanitOS qubes."
	if [ -e "${serve_pidfile}" ]; then
		kill "$(cat "${serve_pidfile}")" 2>/dev/null
		rm -f "${serve_pidfile}"
	fi
	# Guests are asked through their agent to shut down, app qubes first,
	# then firewalls, then sys-net; the ones that do not are forced off.
	"${jos_bin}" --config "${jos_config}" stop --all --timeout "${jos_stop_timeout}"
	# Then the leftovers: supervisors (known by their pidfiles) and
	# anything else in /dev/vmm (e.g. started by hand) are destroyed.
	for pid in /var/run/juanitos/*.pid; do
		[ -e "${pid}" ] || continue
		vm=$(basename "${pid}" .pid)
		"${jos_bin}" --config "${jos_config}" kill "${vm}"
	done
	for vm in /dev/vmm/*; do
		[ -e "${vm}" ] || continue
		"${jos_bin}" --config "${jos_config}" kill "$(basename "${vm}")"
	done
}

jos_status()
{
	"${jos_bin}" --config "${jos_config}" ls
}

run_rc_command "$1"

#!/bin/sh
#
# PROVIDE: jos-login
# REQUIRE: LOGIN seatd dbus jos-splash-finish
# KEYWORD: shutdown
#
# The JuanitOS login screen: jos-greet on ttyv8 (VT 9, Alt+F9), which no
# getty uses (its /etc/ttys line is "off"). It runs under daemon(8) so it
# comes back if it ever dies; ttyv0 (Alt+F1) keeps its text login.
#
# jos_login_enable="YES"   start the login screen
# jos_login_bin            the greeter (/usr/local/bin/jos-greet)
# jos_login_vt             its virtual terminal, 1-based (9 = ttyv8)
#
# rc.d/jos-splash-finish runs first and leaves the boot picture up; the
# greeter replaces it when it switches to its terminal. At shutdown the
# greeter is stopped first, then rc.d/jos-splash-shutdown draws the card.

. /etc/rc.subr

name="jos_login"
rcvar="jos_login_enable"

load_rc_config $name

: ${jos_login_enable:="NO"}
: ${jos_login_bin:="/usr/local/bin/jos-greet"}
: ${jos_login_vt:="9"}

pidfile="/var/run/${name}.pid"
command="/usr/sbin/daemon"
command_args="-R 2 -S -T jos-greet -P ${pidfile} ${jos_login_bin} run --vt ${jos_login_vt}"
start_precmd="jos_login_prestart"

jos_login_prestart()
{
	if [ ! -x "${jos_login_bin}" ]; then
		warn "${jos_login_bin} is not installed; no login screen"
		return 1
	fi
	# jos-greet makes /var/run/user/<uid> (mode 700, owned by the user)
	# for each session's XDG_RUNTIME_DIR.
	mkdir -p /var/run/user
	chmod 755 /var/run/user
	if ! jos_login_has_framebuffer; then
		warn "console is in VGA text mode (BIOS boot, no KMS driver); keeping the text login on ttyv0"
		return 1
	fi
}

# vt(4) names its driver at boot ("VT(efifb): resolution ...", or
# "VT(vga): text 80x25" after a BIOS boot); a KMS driver loaded later
# logs "VT: Replacing driver "vga" with new "fb"". The greeter needs a
# framebuffer, and without one daemon(8) would restart it forever.
jos_login_has_framebuffer()
{
	local last
	last=$(/sbin/dmesg -a 2>/dev/null | grep -E '^VT(\(|: Replacing driver)' | tail -n 1)
	case "${last}" in
	"VT(vga): text"*) return 1 ;;
	esac
	return 0
}

run_rc_command "$1"

#!/bin/sh
#
# PROVIDE: jos-splash-finish
# REQUIRE: LOGIN jos
# BEFORE: cosmic_greeter
#
# Ends the boot splash. With the COSMIC greeter enabled the last frame
# (every icon lit) stays on the framebuffer until the compositor takes the
# display; otherwise the text console comes back for the login prompt.

. /etc/rc.subr

name="jos_splash_finish"
rcvar="jos_splash_enable"

load_rc_config jos_splash
load_rc_config cosmic_greeter

: ${jos_splash_enable:="NO"}
: ${jos_splash_bin:="/usr/local/bin/jos-splash"}
: ${cosmic_greeter_enable:="NO"}

start_cmd="jos_splash_finish_start"
stop_cmd=":"

jos_splash_finish_start()
{
	[ -x "${jos_splash_bin}" ] || return 0
	"${jos_splash_bin}" stage desktop
	# Keep the picture only for a greeter that will actually take the
	# screen: COSMIC may be enabled in rc.conf but not (yet) installed.
	if checkyesno cosmic_greeter_enable && \
	    [ -x /usr/local/etc/rc.d/cosmic_greeter ]; then
		"${jos_splash_bin}" finish
	else
		"${jos_splash_bin}" finish --console
	fi
}

run_rc_command "$1"

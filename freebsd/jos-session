#!/bin/sh
# SPDX-License-Identifier: BSD-3-Clause
#
# JuanitOS: run a desktop session for the user who just logged in.
# jos-greet (the login screen) starts every session as
#   /usr/local/libexec/jos-session <Exec= of the session's .desktop file>
# with the user's credentials and environment already set, so this ends
# by exec'ing the session command it was given (`start-cosmic`).
#
# A Wayland compositor refuses to start without XDG_RUNTIME_DIR. jos-greet
# makes /var/run/user/<uid>; when the script is run some other way (from
# a text console) fall back to a private directory under /tmp.

uid=$(id -u)
if [ -z "${XDG_RUNTIME_DIR:-}" ] || [ ! -d "${XDG_RUNTIME_DIR}" ]; then
	for dir in "/var/run/user/${uid}" "/tmp/jos-run-${uid}"; do
		if mkdir -p "${dir}" 2>/dev/null && [ -O "${dir}" ] && chmod 700 "${dir}"; then
			XDG_RUNTIME_DIR=${dir}
			break
		fi
	done
	export XDG_RUNTIME_DIR
fi
export XDG_SESSION_TYPE=wayland
: "${XDG_CURRENT_DESKTOP:=COSMIC}"
export XDG_CURRENT_DESKTOP
# jos_vmsvga (VirtualBox's VMSVGA, QEMU's vmware display) is a KMS driver
# without 3D and without a render node: Mesa's GBM refuses it ("failed to
# get compatible render device") unless told to render in software
# (kms_swrast on the dumb buffers).
if /sbin/kldstat -q -n jos_vmsvga; then
	: "${GBM_ALWAYS_SOFTWARE:=1}"
	export GBM_ALWAYS_SOFTWARE
fi
exec "$@"

# SPDX-License-Identifier: BSD-3-Clause
# clang-format for the C sources JuanitOS maintains, checked by
# `cargo xtask fmt` (applied with --fix). Vendored C (freebsd/geom_ventoy)
# has its own .clang-format that turns formatting off, so it stays as
# upstream has it.
BasedOnStyle: LLVM
# Every if/else/for/while body in braces: a statement added to an unbraced
# body is a classic bug. clang-tidy's readability-braces-around-statements
# fails the build on what this does not catch.
InsertBraces: true
# The `*` goes with the type (`struct jos_vmsvga* sc`): it is part of the
# type, not of the name. One declarator per declaration keeps that honest
# (`int* a, b` would make only `a` a pointer).
PointerAlignment: Left
# FreeBSD kernel headers are not self-contained: <sys/param.h>, then
# <sys/systm.h>, must come before the others (FreeBSD's own .clang-format
# has the same rule). The rest of an include block is sorted as usual.
IncludeCategories:
  - Regex: '^<sys/param\.h>'
    Priority: 1
  - Regex: '^<sys/systm\.h>'
    Priority: 2
  - Regex: '.*'
    Priority: 3
